; Engine configuration file.
; Warrior's Art — Godot 4.x project.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Warrior's Art"
config/description="A cinematic 2D State-vs-State Indian martial-arts fighting game."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/autoload/game_state.gd"
Rng="*res://src/autoload/rng.gd"
Log="*res://src/autoload/log.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

