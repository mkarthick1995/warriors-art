[physics]

; Fighting-game sim runs at a fixed 60 Hz tick — see docs/ARCHITECTURE.md.
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

; GL Compatibility: lightest renderer, ideal for a 2D sprite fighter and the
; broadest range of team/playtester hardware.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Nearest-neighbour filtering for crisp pixel art.
textures/canvas_textures/default_texture_filter=0
