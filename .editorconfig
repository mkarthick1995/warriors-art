root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript uses tabs (Godot default)
[*.gd]
indent_style = tab

[*.{tscn,tres,godot,cfg}]
indent_style = tab

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
